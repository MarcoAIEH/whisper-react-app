# Add these in Vercel Project Settings → Environment Variables. Do not commit real values.
ELEVENLABS_API_KEY=
# Created automatically when a private Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=
# Random secret used only by Vercel Cron to delete abandoned uploads.
CRON_SECRET=
# Chiave Anthropic per i preset di trasformazione (facoltativa). Mai nel codice.
ANTHROPIC_API_KEY=
# Modello opzionale (default: claude-sonnet-5-5).
ANTHROPIC_MODEL=
